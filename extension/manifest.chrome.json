{
  "manifest_version": 3,
  "name": "Sussurro",
  "version": "0.0.0",
  "description": "Capture web meetings (Google Meet, Microsoft Teams, Zoom) into the Sussurro desktop app. Everything stays on your computer.",
  "homepage_url": "https://github.com/fullo/Sussurro",
  "minimum_chrome_version": "116",
  "icons": {
    "32": "icons/32.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Sussurro",
    "default_icon": {
      "32": "icons/32.png",
      "64": "icons/64.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "sidePanel", "tabCapture", "offscreen"],
  "message_serialization": "structured_clone",
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.zoom.us/wc/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/wc/*"
      ],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/wc/*"
      ],
      "js": ["content-isolated.js"],
      "run_at": "document_start"
    }
  ]
}
