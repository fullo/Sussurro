{
  "manifest_version": 3,
  "name": "Sussurro",
  "version": "0.0.0",
  "description": "Capture web meetings (Google Meet, Microsoft Teams, Zoom) into the Sussurro desktop app. Everything stays on your computer.",
  "homepage_url": "https://github.com/fullo/Sussurro",
  "browser_specific_settings": {
    "gecko": {
      "id": "sussurro@darumahq.it",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "32": "icons/32.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Sussurro",
    "default_icon": {
      "32": "icons/32.png",
      "64": "icons/64.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "sidebar_action": {
    "default_title": "Sussurro",
    "default_panel": "sidepanel.html",
    "default_icon": {
      "32": "icons/32.png",
      "64": "icons/64.png"
    },
    "open_at_install": false
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'"
  },
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.zoom.us/wc/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/wc/*"
      ],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/wc/*"
      ],
      "js": ["content-isolated.js"],
      "run_at": "document_start"
    }
  ]
}
